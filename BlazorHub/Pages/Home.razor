@page "/"
@inject HttpClient Http
@inject VectorSearchService SearchService
@inject IJSRuntime JS

<!-- Apple Global Navigation -->
<header class="header">
    <a href="#" class="header-logo">
        <div class="logo-badge"></div>
        <div>
            <div class="logo-title">OpenCode &amp; OpenWork Hub</div>
        </div>
    </a>

    <div class="search-wrap">
        <span class="search-icon" @onclick="TriggerSearch" style="cursor: pointer;" title="클릭하여 AI 시맨틱 검색 실행">🔍</span>
        <input class="search-input"
               type="text"
               placeholder="자연어 질문 입력 후 Enter (예: '쿠버네티스 파드 재시작', 'FTP 업로드')"
               value="@_searchQuery"
               @oninput="OnSearchInput"
               @onkeydown="OnSearchKeyDown" />
        <button class="btn-search-submit" @onclick="TriggerSearch" title="AI 시맨틱 검색 실행 (Enter)">
            <span>AI 검색 ↵</span>
        </button>
    </div>

    <div class="header-actions">
        <button @onclick="OpenGithubModal" class="btn-apple" title="GitHub에서 신규 에셋 검색 및 DB 추가" style="color: var(--apple-blue); border-color: var(--apple-blue-border); background: var(--apple-blue-dim);">
            🌐 GitHub 탐색 &amp; 추가
        </button>
        <a href="https://github.com/kurtkim80/skills" target="_blank" rel="noopener noreferrer" class="btn-apple btn-github" title="GitHub 저장소 바로가기" style="text-decoration: none;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle;">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub</span>
        </a>
        <button @onclick="ToggleTheme" class="btn-apple" title="다크/라이트 테마 전환">@(_currentTheme == "light" ? "☀️ 라이트" : "🌙 다크")</button>
        <button @onclick="TriggerSync" class="btn-primary" disabled="@_isSyncing">@(_isSyncing ? "⏳ 수집 중..." : "🔄 Sync")</button>
        <div class="header-stat">
            <small>TOTAL</small>
            <strong>@(SearchService.AllItems.Count > 0 ? SearchService.AllItems.Count.ToString("N0") : "6,186")</strong>
        </div>
    </div>
</header>

<!-- AI Status Banner -->
@if (_showStatusBar)
{
    <div class="ai-status-bar">
        <div class="ai-status-inner">
            @if (_isAiWorking)
            {
                <span class="ai-spinner"></span>
            }
            <span>@_statusText</span>
        </div>
        <small style="opacity:0.8;">C# .NET 10 WebAssembly + SIMD Vector DB</small>
    </div>
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-eyebrow">Next-Generation AI Agent Toolkit</div>
    <h1>OpenCode &amp; OpenWork Hub</h1>
    <p>인터넷과 GitHub의 최고 성능 AI 코딩 에이전트 스킬, 커맨드, 페르소나를 한 곳에서 탐색하고 원클릭으로 설치하세요.</p>
    <div>
        <button @onclick="OpenGithubModal" class="btn-apple" style="border-color: var(--apple-blue-border); color: var(--apple-blue); font-size: 13px; padding: 7px 20px; box-shadow: 0 4px 14px rgba(0, 113, 227, 0.15);">
            🌐 찾으시는 스킬이 없나요? GitHub에서 실시간 검색 &amp; DB 추가하기 →
        </button>
    </div>
</section>

<!-- Segmented Tabs Navigation -->
<div class="tabs-container">
    <div class="tabs">
        @foreach (var cat in _categories)
        {
            var count = GetCategoryCount(cat.Id);
            <button class="tab-btn @(cat.Id == _selectedCategory ? "active" : "")"
                    @onclick="() => SelectCategory(cat.Id)">
                @cat.Label <span class="tab-count">@count</span>
            </button>
        }
    </div>
</div>

<!-- Main Content Area -->
<main class="main">
    <div class="results-bar">
        @if (_isSearchActive && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            <p>🧠 AI 시맨틱 검색 결과: <span>@_displayItems.Count</span>개 (의미 유사도 순, C# SIMD)</p>
        }
        else
        {
            <p>전체 <span>@_displayItems.Count</span>개 에셋</p>
        }
    </div>

    @if (_displayItems.Count == 0 && SearchService.IsCatalogLoaded)
    {
        <div class="empty" style="display: block;">
            <div class="empty-icon">🔍</div>
            <h3>검색 결과가 없습니다</h3>
            <p>다른 검색어나 카테고리를 선택하시거나, 상단의 <strong>[🌐 GitHub 탐색 &amp; 추가]</strong> 버튼으로 신규 에셋을 검색해 보세요.</p>
            <div style="margin-top: 18px;">
                <button @onclick="OpenGithubModal" class="btn-primary">🌐 GitHub에서 찾아보기</button>
            </div>
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var item in _displayItems)
            {
                var isCommand = item.Type == "command";
                var badgeClass = isCommand ? "badge-command" : "badge-skill";
                var badgeLabel = isCommand ? "COMMAND" : "SKILL";
                var desc = string.IsNullOrEmpty(item.Desc) ? "상세 지침 및 사양을 보려면 카드를 클릭하세요." : item.Desc;
                var srcShort = item.Source.Length > 22 ? item.Source.Substring(0, 22) + "…" : item.Source;

                <div class="card" @onclick="() => OpenModal(item)">
                    <div class="card-badges">
                        <span class="badge @badgeClass">@badgeLabel</span>
                        @if (item.AiScore > 0f)
                        {
                            <span class="badge badge-ai-score" title="C# TensorPrimitives 코사인 유사도 점수">
                                🧠 AI 매칭 @(Math.Round(item.AiScore * 100))%
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(item.RepoUrl))
                        {
                            <a href="@item.RepoUrl" target="_blank" rel="noopener noreferrer" class="badge-src-link" @onclick:stopPropagation="true" title="원본 GitHub 저장소 바로가기: @item.Source">
                                🐙 @srcShort ↗
                            </a>
                        }
                        else
                        {
                            <span class="badge-src" title="@item.Source">@srcShort</span>
                        }
                    </div>

                    <div class="card-cat">@item.CatLabel</div>
                    <div class="card-name">@item.Name</div>
                    <div class="card-desc">@desc</div>

                    <div class="card-footer">
                        <span class="card-footer-label">세부 사양 보기 →</span>
                        <button class="btn-install" title="설치 명령어 복사" @onclick="() => CopyCommand(item.Install)" @onclick:stopPropagation="true">
                            📋 설치
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</main>

<!-- Footer -->
<footer class="footer">
    <div class="footer-inner">
        <p>OpenCode &amp; OpenWork Skills Dashboard · Apple HIG Design System · Blazor WebAssembly (.NET 10)</p>
        <a href="https://github.com/kurtkim80/skills" target="_blank" rel="noopener noreferrer" class="footer-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>github.com/kurtkim80/skills 바로가기 ↗</span>
        </a>
    </div>
</footer>

<!-- Modal 1: Detail Modal (iOS Sheet) -->
@if (_selectedModalItem != null)
{
    var modal = _selectedModalItem;
    var isCommand = modal.Type == "command";
    var badgeClass = isCommand ? "badge-command" : "badge-skill";
    var badgeLabel = isCommand ? "COMMAND" : "SKILL";

    <div class="modal-overlay @(_isModalOpen ? "open" : "")" @onclick="CloseModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-head">
                <div class="modal-head-info">
                    <div class="modal-badges">
                        <span class="badge @badgeClass">@badgeLabel</span>
                        <span class="badge" style="background:var(--segment-bg);color:var(--text-secondary)">@modal.CatLabel</span>
                        @if (!string.IsNullOrEmpty(modal.RepoUrl))
                        {
                            <a href="@modal.RepoUrl" target="_blank" rel="noopener noreferrer" class="btn-apple" style="padding: 3px 10px; font-size: 11px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-left: 4px;" title="원본 GitHub 저장소 새 탭으로 열기">
                                🐙 원본 GitHub: @modal.Source ↗
                            </a>
                        }
                        else
                        {
                            <span style="font-size:11px;color:var(--text-muted);margin-left:4px">출처: @modal.Source</span>
                        }
                    </div>
                    <div class="modal-name">@modal.Name</div>
                    <div class="modal-desc">@modal.Desc</div>
                </div>
                <button class="btn-close" @onclick="CloseModal">✕</button>
            </div>

            <div class="modal-install">
                <code>@modal.Install</code>
                <button class="btn-copy @(_isCopied ? "copied" : "")" @onclick="() => CopyModalInstall(modal.Install)">
                    @(_isCopied ? "✅ 복사됨" : "📋 복사")
                </button>
            </div>

            <div class="modal-body">
                <div class="modal-body-label">SPECIFICATION &amp; INSTRUCTIONS</div>
                <div class="mac-terminal">
                    <div class="mac-terminal-bar">
                        <span class="mac-dot dot-red"></span>
                        <span class="mac-dot dot-yellow"></span>
                        <span class="mac-dot dot-green"></span>
                        <span class="mac-terminal-title">SKILL.md preview</span>
                    </div>
                    <pre class="modal-content-pre">@_modalContent</pre>
                </div>
            </div>

            <div class="modal-foot">
                <small>ESC 키 또는 바깥 영역을 클릭하여 닫기</small>
                <button class="btn-apple" @onclick="CloseModal">닫기</button>
            </div>
        </div>
    </div>
}

<!-- Modal 2: GitHub Search & Add to DB Modal -->
@if (_isGithubModalOpen)
{
    <div class="modal-overlay open" @onclick="CloseGithubModal">
        <div class="modal" style="max-width: 840px;" @onclick:stopPropagation="true">
            <div class="modal-head">
                <div class="modal-head-info">
                    <div class="modal-badges">
                        <span class="badge badge-skill" style="background: var(--apple-blue-dim); color: var(--apple-blue);">🌐 GITHUB SEARCH &amp; ADD</span>
                    </div>
                    <div class="modal-name">GitHub 에셋 실시간 검색 및 DB 추가</div>
                    <div class="modal-desc">GitHub에서 AI 코딩 에이전트 스킬, 커맨드, MCP 저장소를 검색하여 내 카탈로그 DB에 즉시 등록합니다.</div>
                </div>
                <button class="btn-close" @onclick="CloseGithubModal">✕</button>
            </div>

            <div class="modal-body">
                <div class="github-search-input-wrap">
                    <input class="github-search-input"
                           type="text"
                           placeholder="GitHub 저장소/스킬 검색 (예: kubernetes, langchain, drawio, agentic, mcp)"
                           value="@_githubQuery"
                           @oninput='(e) => _githubQuery = e.Value?.ToString() ?? ""'
                           @onkeydown="OnGithubSearchKeyDown" />
                    <button class="btn-primary" @onclick="() => ExecuteGithubSearch(_githubQuery)" disabled="@_isSearchingGithub" style="flex-shrink: 0;">
                        @(_isSearchingGithub ? "⏳ 검색 중..." : "🔍 GitHub 검색")
                    </button>
                </div>

                <div class="github-pill-suggestions">
                    <span style="font-size: 11px; color: var(--text-muted); align-self: center;">추천 검색어:</span>
                    <button class="github-pill" @onclick='() => SetQueryAndSearch("kubernetes skills")'>#kubernetes</button>
                    <button class="github-pill" @onclick='() => SetQueryAndSearch("drawio-skill")'>#drawio-skill</button>
                    <button class="github-pill" @onclick='() => SetQueryAndSearch("langchain agent skills")'>#langchain</button>
                    <button class="github-pill" @onclick='() => SetQueryAndSearch("rag skills")'>#rag</button>
                    <button class="github-pill" @onclick='() => SetQueryAndSearch("mcp server")'>#mcp</button>
                    <button class="github-pill" @onclick='() => SetQueryAndSearch("opencode skills")'>#opencode</button>
                    <button class="github-pill" @onclick='() => SetQueryAndSearch("claude skills")'>#claude</button>
                </div>

                @if (_isSearchingGithub)
                {
                    <div style="text-align: center; padding: 40px 20px;">
                        <span class="ai-spinner" style="width: 28px; height: 28px; border-width: 3px; margin-bottom: 12px;"></span>
                        <p style="font-size: 13px; color: var(--text-muted);">GitHub API에서 최신 저장소를 검색하는 중입니다...</p>
                    </div>
                }
                else if (_githubResults.Count > 0)
                {
                    <div class="github-results-list">
                        @foreach (var repo in _githubResults)
                        {
                            var alreadyAdded = SearchService.IsItemInCatalog(repo.FullName) || repo.IsAdded;
                            var (catId, catLabel) = VectorSearchService.ClassifyCategory(repo.Name, repo.Description);

                            <div class="github-repo-card">
                                <div class="github-repo-header">
                                    <div>
                                        <a href="@repo.HtmlUrl" target="_blank" rel="noopener noreferrer" class="github-repo-title">
                                            🐙 @repo.FullName ↗
                                        </a>
                                        <span class="badge" style="margin-left: 8px; font-size: 10px; background: var(--segment-bg); color: var(--text-secondary);">
                                            @catLabel
                                        </span>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span style="font-size: 12px; font-weight: 600; color: #ffd60a;">
                                            ⭐ @repo.StargazersCount.ToString("N0")
                                        </span>
                                        @if (alreadyAdded)
                                        {
                                            <button class="btn-apple" disabled style="color: var(--green); border-color: rgba(48, 209, 88, 0.3); background: var(--green-dim); font-size: 11px; padding: 4px 10px;">
                                                ✅ DB에 등록됨
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-primary" @onclick="() => AddRepoToDb(repo)" disabled="@repo.IsAdding" style="font-size: 11px; padding: 4px 12px;">
                                                @(repo.IsAdding ? "⏳ 추가 중..." : "➕ DB에 추가")
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="github-repo-desc">
                                    @(string.IsNullOrWhiteSpace(repo.Description) ? "저장소 설명이 없습니다." : repo.Description)
                                </div>

                                <div class="github-repo-meta">
                                    <span>🍴 포크: @repo.ForksCount.ToString("N0")개</span>
                                    @if (!string.IsNullOrEmpty(repo.UpdatedAt))
                                    {
                                        <span>업데이트: @(repo.UpdatedAt.Length >= 10 ? repo.UpdatedAt.Substring(0, 10) : repo.UpdatedAt)</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(_githubStatusMessage))
                {
                    <div style="text-align: center; padding: 30px 20px;">
                        <p style="font-size: 13px; color: var(--text-muted);">@_githubStatusMessage</p>
                    </div>
                }
            </div>

            <div class="modal-foot">
                <small>추가된 에셋은 즉시 메인 카탈로그 DB에 반영되며 브라우저에 저장됩니다.</small>
                <button class="btn-apple" @onclick="CloseGithubModal">닫기</button>
            </div>
        </div>
    </div>
}

<!-- Toast -->
@if (_showToast)
{
    <div class="toast show">✅ <span>@_toastMessage</span></div>
}

@code {
    private string _searchQuery = "";
    private string _selectedCategory = "all";
    private List<SkillItem> _displayItems = new();
    private bool _isSearchActive = false;
    private bool _isAiWorking = false;
    private string _statusText = "";
    private bool _showStatusBar = false;
    private SkillItem? _selectedModalItem;
    private string _modalContent = "";
    private bool _isModalOpen = false;
    private bool _isCopied = false;
    private string _currentTheme = "dark";
    private bool _isSyncing = false;
    private string _toastMessage = "";
    private bool _showToast = false;
    private DotNetObjectReference<Home>? _dotNetRef;

    // GitHub 실시간 검색 관련 상태
    private bool _isGithubModalOpen = false;
    private string _githubQuery = "";
    private bool _isSearchingGithub = false;
    private string _githubStatusMessage = "";
    private List<GitHubRepoItem> _githubResults = new();

    private readonly record struct CategoryInfo(string Id, string Label);
    private readonly List<CategoryInfo> _categories = new()
    {
        new("all", "전체"),
        new("rag_search", "🔍 RAG & 시맨틱 검색"),
        new("llm_ai", "🧠 LLM & AI 개발"),
        new("frontend", "🎨 프론트엔드 & UI/UX"),
        new("backend", "⚙️ 백엔드 & API"),
        new("database", "🗄️ DB & 데이터"),
        new("devops", "☁️ DevOps & 클라우드"),
        new("security", "🛡️ 보안 & 취약점"),
        new("testing", "🧪 테스트 & QA"),
        new("architecture", "🏗️ 아키텍처 & 리뷰"),
        new("mobile_sys", "📱 모바일 & 시스템"),
        new("general_dev", "💻 일반 언어 & 도구"),
        new("workflow", "⚡ 워크플로우 커맨드"),
        new("agent", "🤖 자율 에이전트")
    };

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);

        // 1단계: 초경량 4.8MB 카탈로그 먼저 로드하여 즉시 화면 렌더링
        await SearchService.LoadCatalogAsync();

        // 2단계: 로컬 스토리지에 저장된 사용자 추가 커스텀 스킬 로드
        try
        {
            var customJson = await JS.InvokeAsync<string>("getCustomSkills");
            if (!string.IsNullOrWhiteSpace(customJson) && customJson != "[]")
            {
                var customItems = System.Text.Json.JsonSerializer.Deserialize<List<SkillItem>>(customJson);
                SearchService.MergeCustomItems(customItems);
            }
        }
        catch { }

        _displayItems = SearchService.GetCategoryItems(_selectedCategory);

        // 3단계: 9.5MB AI 벡터 DB는 백그라운드에서 비동기로 조용히 로드 (화면 블로킹 없음)
        _ = Task.Run(async () =>
        {
            await SearchService.EnsureVectorsLoadedAsync();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _currentTheme = await JS.InvokeAsync<string>("getSavedTheme");
                await JS.InvokeVoidAsync("setAppTheme", _currentTheme);
                StateHasChanged();
            }
            catch { }
        }
    }

    private int GetCategoryCount(string catId)
    {
        if (catId == "all") return SearchService.AllItems.Count;
        return SearchService.AllItems.Count(x => x.CatId == catId);
    }

    private void SelectCategory(string catId)
    {
        _selectedCategory = catId;
        if (_isSearchActive && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            _displayItems = SearchService.GetFilteredSearchResults(_selectedCategory);
        }
        else
        {
            _displayItems = SearchService.GetCategoryItems(_selectedCategory);
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _isSearchActive = false;
            SearchService.ResetScores();
            _displayItems = SearchService.GetCategoryItems(_selectedCategory);
            _showStatusBar = false;
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await TriggerSearch();
        }
    }

    private async Task TriggerSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _isSearchActive = false;
            SearchService.ResetScores();
            _displayItems = SearchService.GetCategoryItems(_selectedCategory);
            _showStatusBar = false;
            return;
        }

        _isSearchActive = true;
        _showStatusBar = true;
        _isAiWorking = true;
        _statusText = $"🧠 \"{_searchQuery}\" 자연어 의미 벡터 계산 및 C# SIMD 유사도 랭킹 산출 중...";
        StateHasChanged();

        try
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();
            var qVec = await JS.InvokeAsync<float[]>("vectorizeQuery", _searchQuery, _dotNetRef);
            sw.Stop();

            if (qVec != null && qVec.Length == 384)
            {
                var simdSw = System.Diagnostics.Stopwatch.StartNew();
                _displayItems = await SearchService.SearchAsync(qVec, _selectedCategory, limit: 80);
                simdSw.Stop();

                _statusText = $"⚡ {SearchService.AllItems.Count:N0}개 에셋 C# SIMD 시맨틱 비교 완료 (C# SIMD: {simdSw.Elapsed.TotalMilliseconds:F1}ms, 임베딩: {sw.ElapsedMilliseconds}ms)";
            }
            else
            {
                _statusText = "⚠️ AI 벡터 추출 실패. 다시 시도해 주세요.";
            }
        }
        catch (Exception ex)
        {
            _statusText = $"❌ AI 검색 오류: {ex.Message}";
        }
        finally
        {
            _isAiWorking = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnModelDownloadProgress(int progress)
    {
        _statusText = $"AI 모델 다운로드 중 ({progress}%)...";
        StateHasChanged();
    }

    // ── GitHub Search & Add Modal Logic ──
    private void OpenGithubModal()
    {
        _isGithubModalOpen = true;
        if (_githubResults.Count == 0 && string.IsNullOrWhiteSpace(_githubQuery))
        {
            _ = SetQueryAndSearch("kubernetes skills");
        }
    }

    private void CloseGithubModal()
    {
        _isGithubModalOpen = false;
    }

    private async Task OnGithubSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteGithubSearch(_githubQuery);
        }
    }

    private async Task SetQueryAndSearch(string q)
    {
        _githubQuery = q;
        await ExecuteGithubSearch(q);
    }

    private async Task ExecuteGithubSearch(string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return;

        _isSearchingGithub = true;
        _githubStatusMessage = "";
        StateHasChanged();

        try
        {
            var encoded = Uri.EscapeDataString(query.Trim());
            var apiUrl = $"https://api.github.com/search/repositories?q={encoded}&sort=stars&order=desc&per_page=15";

            var response = await Http.GetFromJsonAsync<GitHubSearchResult>(apiUrl);
            if (response != null && response.Items.Count > 0)
            {
                _githubResults = response.Items;
                _githubStatusMessage = $"'{query}' 검색 결과: 총 {response.TotalCount:N0}개 중 상위 {_githubResults.Count}개 표시";
            }
            else
            {
                _githubResults.Clear();
                _githubStatusMessage = "검색 결과가 없습니다. 다른 검색어를 입력해 보세요.";
            }
        }
        catch (Exception ex)
        {
            _githubResults.Clear();
            _githubStatusMessage = $"GitHub 검색 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            _isSearchingGithub = false;
            StateHasChanged();
        }
    }

    private async Task AddRepoToDb(GitHubRepoItem repo)
    {
        repo.IsAdding = true;
        StateHasChanged();

        try
        {
            var (catId, catLabel) = VectorSearchService.ClassifyCategory(repo.Name, repo.Description);
            var newItem = new SkillItem
            {
                Id = repo.Name,
                Name = repo.Name,
                Type = "skill",
                CatId = catId,
                CatLabel = catLabel,
                Desc = string.IsNullOrEmpty(repo.Description) ? $"GitHub에서 추가된 스킬 저장소: {repo.FullName}" : repo.Description,
                Source = repo.FullName,
                RepoUrl = repo.HtmlUrl,
                Install = $"mkdir -p ~/.config/opencode/skills/{repo.Name} && curl -fsSL https://raw.githubusercontent.com/{repo.FullName}/main/SKILL.md -o ~/.config/opencode/skills/{repo.Name}/SKILL.md",
                Doc = $"https://raw.githubusercontent.com/{repo.FullName}/main/SKILL.md"
            };

            // 1. 메모리 카탈로그 DB에 추가
            SearchService.AddItem(newItem);
            repo.IsAdded = true;

            // 2. 브라우저 localStorage에 영구 저장
            var json = System.Text.Json.JsonSerializer.Serialize(SearchService.CustomItems);
            await JS.InvokeVoidAsync("saveCustomSkills", json);

            // 3. 로컬 서버(server.py) 모드일 경우 sources.json 동기화 API 호출 시도
            try
            {
                var addSourcePayload = new { repo = repo.CloneUrl, name = repo.Name };
                await Http.PostAsJsonAsync("/api/add-source", addSourcePayload);
            }
            catch { }

            // 4. 메인 화면 뷰 갱신
            if (_isSearchActive && !string.IsNullOrWhiteSpace(_searchQuery))
            {
                _displayItems = SearchService.GetFilteredSearchResults(_selectedCategory);
            }
            else
            {
                _displayItems = SearchService.GetCategoryItems(_selectedCategory);
            }

            await ShowToast($"'{repo.FullName}'이(가) 내 카탈로그 DB에 추가되었습니다!");
        }
        catch (Exception ex)
        {
            await ShowToast($"추가 실패: {ex.Message}");
        }
        finally
        {
            repo.IsAdding = false;
            StateHasChanged();
        }
    }

